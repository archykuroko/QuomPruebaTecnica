@page "/suppliers"
@layout MainLayout

@using Quom.AssetManagement.Web.Components.Layout
@using Quom.AssetManagement.Web.Models
@using Quom.AssetManagement.Web.Services
@using Quom.AssetManagement.Web.State

@inject SupplierApiService SupplierApiService
@inject AuthState AuthState
@inject NavigationManager Navigation

<PageTitle>Proveedores | Quom</PageTitle>

<div class="suppliers-page">

    <div class="page-header">

        <div>

            <p class="page-eyebrow">
                Administración
            </p>

            <h1 class="page-title">
                Proveedores
            </h1>

            <p class="page-description">
                Consulta proveedores y administra los servicios asociados.
            </p>

        </div>

        @if (AuthState.IsAdministrator)
        {
            <button class="primary-action"
                    @onclick="GoToCreate">

                <svg viewBox="0 0 24 24"
                     fill="none"
                     stroke="currentColor"
                     stroke-width="1.8"
                     class="h-4 w-4">

                    <path stroke-linecap="round"
                          stroke-linejoin="round"
                          d="M12 5v14M5 12h14" />

                </svg>

                <span>
                    Nuevo proveedor
                </span>

            </button>
        }

    </div>


    <div class="summary-grid">

        <div class="summary-card">

            <p class="summary-label">
                Total proveedores
            </p>

            <p class="summary-value">
                @suppliers.Count
            </p>

            <p class="summary-description">
                Registros existentes
            </p>

        </div>


        <div class="summary-card">

            <p class="summary-label">
                Activos
            </p>

            <p class="summary-value">
                @ActiveCount
            </p>

            <p class="summary-description">
                Proveedores habilitados
            </p>

        </div>


        <div class="summary-card">

            <p class="summary-label">
                Inactivos
            </p>

            <p class="summary-value">
                @InactiveCount
            </p>

            <p class="summary-description">
                Registros no disponibles
            </p>

        </div>

    </div>


    <div class="business-rule">

        <div class="business-rule-marker">
            i
        </div>

        <div>

            <p class="business-rule-title">
                Servicios de proveedor
            </p>

            <p class="business-rule-text">
                Cada proveedor puede tener uno o más tipos de servicio asociados.
                @if (!AuthState.IsAdministrator)
                {
                    <span>
                        Tu perfil cuenta con acceso de consulta.
                    </span>
                }
            </p>

        </div>

    </div>


    <section class="suppliers-card">

        <div class="toolbar">

            <div class="search-wrapper">

                <svg viewBox="0 0 24 24"
                     fill="none"
                     stroke="currentColor"
                     stroke-width="1.6"
                     class="search-icon">

                    <path stroke-linecap="round"
                          stroke-linejoin="round"
                          d="m21 21-4.35-4.35m1.35-5.4a6.75 6.75 0 1 1-13.5 0 6.75 6.75 0 0 1 13.5 0Z" />

                </svg>

                <input class="search-input"
                       @bind="searchText"
                       @bind:event="oninput"
                       placeholder="Buscar por nombre, RFC, contacto o correo..." />

            </div>

            <div class="results-count">

                <span class="results-number">
                    @FilteredSuppliers.Count
                </span>

                <span>
                    @(FilteredSuppliers.Count == 1
                        ? "resultado"
                        : "resultados")
                </span>

            </div>

        </div>


        @if (isLoading)
        {
            <div class="table-state">

                <div class="suppliers-spinner"></div>

                <p>
                    Cargando proveedores...
                </p>

            </div>
        }
        else if (!string.IsNullOrWhiteSpace(errorMessage))
        {
            <div class="table-state">

                <p class="error-title">
                    No fue posible cargar los proveedores
                </p>

                <p class="error-description">
                    @errorMessage
                </p>

                <button class="retry-button"
                        @onclick="LoadSuppliersAsync">

                    Reintentar

                </button>

            </div>
        }
        else if (FilteredSuppliers.Count == 0)
        {
            <div class="table-state">

                <p class="empty-title">
                    No se encontraron proveedores
                </p>

                <p class="empty-description">
                    @(string.IsNullOrWhiteSpace(searchText)
                        ? "Todavía no existen proveedores registrados."
                        : "Intenta modificar los criterios de búsqueda.")
                </p>

            </div>
        }
        else
        {
            <div class="table-container">

                <table class="suppliers-table">

                    <thead>

                        <tr>
                            <th>Proveedor</th>
                            <th>RFC / Tax ID</th>
                            <th>Contacto</th>
                            <th>Correo</th>
                            <th>Teléfono</th>
                            <th>Estado</th>
                            <th class="text-right">Acciones</th>
                        </tr>

                    </thead>


                    <tbody>

                        @foreach (var supplier in PagedSuppliers)
                        {
                            <tr>

                                <td>

                                    <div class="supplier-cell">

                                        <div class="supplier-avatar">
                                            @GetInitial(supplier)
                                        </div>

                                        <div>

                                            <p class="supplier-name">
                                                @supplier.Name
                                            </p>

                                            <p class="supplier-secondary">
                                                Proveedor registrado
                                            </p>

                                        </div>

                                    </div>

                                </td>


                                <td>

                                    @if (string.IsNullOrWhiteSpace(supplier.TaxId))
                                    {
                                        <span class="empty-value">
                                            Sin registro
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="standard-value">
                                            @supplier.TaxId
                                        </span>
                                    }

                                </td>


                                <td>

                                    @if (string.IsNullOrWhiteSpace(supplier.ContactName))
                                    {
                                        <span class="empty-value">
                                            Sin contacto
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="standard-value">
                                            @supplier.ContactName
                                        </span>
                                    }

                                </td>


                                <td>

                                    @if (string.IsNullOrWhiteSpace(supplier.Email))
                                    {
                                        <span class="empty-value">
                                            Sin correo
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="standard-value">
                                            @supplier.Email
                                        </span>
                                    }

                                </td>


                                <td>

                                    @if (string.IsNullOrWhiteSpace(supplier.Phone))
                                    {
                                        <span class="empty-value">
                                            Sin teléfono
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="standard-value">
                                            @supplier.Phone
                                        </span>
                                    }

                                </td>


                                <td>

                                    <span class="@GetStatusClass(supplier)">
                                        <span class="status-dot"></span>
                                        @(supplier.IsActive ? "Activo" : "Inactivo")
                                    </span>

                                </td>


                                <td>

                                    <div class="action-group">

                                        <button class="table-action"
                                                title="Ver servicios"
                                                @onclick="() => GoToServices(supplier.Id)">

                                            <svg viewBox="0 0 24 24"
                                                 fill="none"
                                                 stroke="currentColor"
                                                 stroke-width="1.6"
                                                 class="h-4 w-4">

                                                <path stroke-linecap="round"
                                                      stroke-linejoin="round"
                                                      d="M4.5 7.5h15m-15 4.5h15m-15 4.5h9" />

                                            </svg>

                                        </button>


                                        @if (AuthState.IsAdministrator)
                                        {
                                            <button class="table-action"
                                                    title="Administrar servicios"
                                                    @onclick="() => GoToManageServices(supplier.Id)">

                                                <svg viewBox="0 0 24 24"
                                                     fill="none"
                                                     stroke="currentColor"
                                                     stroke-width="1.6"
                                                     class="h-4 w-4">

                                                    <path stroke-linecap="round"
                                                          stroke-linejoin="round"
                                                          d="M12 6.75h8.25M12 17.25h8.25M3.75 6.75h2.5M3.75 17.25h2.5M7.5 4.5v4.5M7.5 15v4.5" />

                                                </svg>

                                            </button>
                                        }

                                    </div>

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>


            <div class="pagination">

                <div class="pagination-info">

                    Mostrando
                    <strong>@FirstVisibleRecord</strong>
                    –
                    <strong>@LastVisibleRecord</strong>
                    de
                    <strong>@FilteredSuppliers.Count</strong>

                </div>


                <div class="pagination-controls">

                    <button class="pagination-button"
                            disabled="@(currentPage <= 1)"
                            @onclick="PreviousPage">

                        Anterior

                    </button>


                    <span class="page-indicator">

                        Página
                        <strong>@currentPage</strong>
                        de
                        <strong>@TotalPages</strong>

                    </span>


                    <button class="pagination-button"
                            disabled="@(currentPage >= TotalPages)"
                            @onclick="NextPage">

                        Siguiente

                    </button>

                </div>

            </div>
        }

    </section>

</div>


<style>

