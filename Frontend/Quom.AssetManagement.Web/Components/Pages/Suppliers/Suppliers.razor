@code {

    private List<SupplierModel> suppliers = [];

    private string searchText = string.Empty;

    private bool isLoading = true;

    private string? errorMessage;

    private int currentPage = 1;

    private const int PageSize = 10;


    private List<SupplierModel> FilteredSuppliers
    {
        get
        {
            IEnumerable<SupplierModel> query =
                suppliers;

            if (!string.IsNullOrWhiteSpace(searchText))
            {
                var term =
                    searchText.Trim();

                query =
                    query.Where(supplier =>
                        Contains(supplier.Name, term)
                        ||
                        Contains(supplier.TaxId, term)
                        ||
                        Contains(supplier.ContactName, term)
                        ||
                        Contains(supplier.Email, term)
                        ||
                        Contains(supplier.Phone, term));
            }

            return query
                .OrderBy(supplier => supplier.Name)
                .ToList();
        }
    }


    private List<SupplierModel> PagedSuppliers =>
        FilteredSuppliers
            .Skip((currentPage - 1) * PageSize)
            .Take(PageSize)
            .ToList();


    private int ActiveCount =>
        suppliers.Count(supplier =>
            supplier.IsActive);


    private int InactiveCount =>
        suppliers.Count(supplier =>
            !supplier.IsActive);


    private int TotalPages =>
        Math.Max(
            1,
            (int)Math.Ceiling(
                FilteredSuppliers.Count /
                (double)PageSize));


    private int FirstVisibleRecord =>
        FilteredSuppliers.Count == 0
            ? 0
            : ((currentPage - 1) * PageSize) + 1;


    private int LastVisibleRecord =>
        Math.Min(
            currentPage * PageSize,
            FilteredSuppliers.Count);


    protected override async Task OnInitializedAsync()
    {
        await LoadSuppliersAsync();
    }


    private async Task LoadSuppliersAsync()
    {
        try
        {
            isLoading = true;
            errorMessage = null;

            var result =
                await SupplierApiService
                    .GetAllAsync();

            suppliers =
                result.ToList();

            currentPage = 1;
        }
        catch (UnauthorizedAccessException)
        {
            Navigation.NavigateTo(
                "/",
                replace: true);
        }
        catch (Exception ex)
        {
            errorMessage =
                ex.Message;
        }
        finally
        {
            isLoading = false;
        }
    }


    private static bool Contains(
        string? value,
        string term)
    {
        return !string.IsNullOrWhiteSpace(value)
            && value.Contains(
                term,
                StringComparison.OrdinalIgnoreCase);
    }


    private static string GetInitial(
        SupplierModel supplier)
    {
        if (string.IsNullOrWhiteSpace(supplier.Name))
            return "P";

        return supplier.Name[..1]
            .ToUpperInvariant();
    }


    private static string GetStatusClass(
        SupplierModel supplier)
    {
        return supplier.IsActive
            ? "status-badge status-active"
            : "status-badge status-inactive";
    }


    private void GoToCreate()
    {
        if (!AuthState.IsAdministrator)
            return;

        Navigation.NavigateTo(
            "/suppliers/new");
    }


    private void GoToServices(
        int supplierId)
    {
        Navigation.NavigateTo(
            $"/suppliers/{supplierId}/services");
    }


    private void GoToManageServices(
        int supplierId)
    {
        if (!AuthState.IsAdministrator)
            return;

        Navigation.NavigateTo(
            $"/suppliers/{supplierId}/services/manage");
    }


    private void PreviousPage()
    {
        if (currentPage <= 1)
            return;

        currentPage--;
    }


    private void NextPage()
    {
        if (currentPage >= TotalPages)
            return;

        currentPage++;
    }

}