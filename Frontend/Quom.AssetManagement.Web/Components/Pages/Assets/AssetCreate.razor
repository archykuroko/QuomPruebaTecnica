@using Quom.AssetManagement.Web.Components.Layout

@page "/assets/create"
@layout MainLayout

@using Quom.AssetManagement.Web.Models
@using Quom.AssetManagement.Web.Services
@using Quom.AssetManagement.Web.State

@inject AssetApiService AssetApiService
@inject SupplierApiService SupplierApiService
@inject AuthState AuthState
@inject NavigationManager Navigation

<PageTitle>Nuevo activo | Quom</PageTitle>

<div class="create-page">

    <button class="back-link"
            @onclick="GoBack">

        <svg viewBox="0 0 24 24"
             fill="none"
             stroke="currentColor"
             stroke-width="1.7"
             class="h-4 w-4">

            <path stroke-linecap="round"
                  stroke-linejoin="round"
                  d="M10.5 19.5 3 12m0 0 7.5-7.5M3 12h18" />

        </svg>

        <span>Volver a activos</span>

    </button>


    <div class="mt-6">

        <p class="text-xs font-semibold uppercase
            tracking-[0.24em] text-slate-500">
            Administración
        </p>

        <h1 class="mt-2 text-3xl font-semibold tracking-tight text-white">
            Nuevo activo
        </h1>

        <p class="mt-2 text-sm text-slate-500">
            Registra un nuevo elemento dentro del inventario tecnológico.
        </p>

    </div>


    @if (!AuthState.IsAdministrator)
    {
        <div class="permission-card mt-8">

            <div class="rule-symbol">
                !
            </div>

            <div>

                <p class="text-sm font-medium text-slate-200">
                    Operación restringida
                </p>

                <p class="mt-1 text-sm leading-6 text-slate-500">
                    La creación de activos está disponible únicamente
                    para usuarios con rol Administrador.
                </p>

            </div>

        </div>
    }
    else if (isLoading)
    {
        <div class="mt-10 flex min-h-72 items-center justify-center">

            <div class="text-center">

                <div class="create-spinner mx-auto"></div>

                <p class="mt-4 text-sm text-slate-500">
                    Preparando formulario...
                </p>

            </div>

        </div>
    }
    else if (!string.IsNullOrWhiteSpace(loadError))
    {
        <div class="error-card mt-8">
            @loadError
        </div>
    }
    else
    {
        <div class="mt-8 grid gap-6 xl:grid-cols-[1fr_340px]">

            @* =====================================================
               FORMULARIO PRINCIPAL
               ===================================================== *@

            <section class="form-card">

                <div class="section-header">

                    <div>

                        <p class="section-label">
                            Información general
                        </p>

                        <p class="mt-2 text-sm text-slate-500">
                            Datos principales de identificación del activo.
                        </p>

                    </div>

                    <span class="required-hint">
                        * Campos obligatorios
                    </span>

                </div>


                <div class="form-grid mt-7">

                    @* Código *@

                    <div>

                        <label class="field-label">
                            Código del activo *
                        </label>

                        <input @bind="assetCode"
                               maxlength="50"
                               placeholder="Ej. TI-LAP-001"
                               class="field-control" />

                    </div>


                    @* Serial *@

                    <div>

                        <label class="field-label">
                            Número de serie
                        </label>

                        <input @bind="serialNumber"
                               maxlength="100"
                               placeholder="Número de serie del fabricante"
                               class="field-control" />

                    </div>


                    @* Categoría *@

                    <div>

                        <label class="field-label">
                            Categoría *
                        </label>

                        <input @bind="category"
                               maxlength="50"
                               placeholder="Ej. Laptop"
                               class="field-control" />

                    </div>


                    @* Marca *@

                    <div>

                        <label class="field-label">
                            Marca *
                        </label>

                        <input @bind="brand"
                               maxlength="100"
                               placeholder="Ej. Dell"
                               class="field-control" />

                    </div>


                    @* Modelo *@

                    <div>

                        <label class="field-label">
                            Modelo
                        </label>

                        <input @bind="model"
                               maxlength="100"
                               placeholder="Ej. Latitude 5440"
                               class="field-control" />

                    </div>


                    @* Ubicación *@

                    <div>

                        <label class="field-label">
                            Ubicación actual
                        </label>

                        <input @bind="currentLocation"
                               maxlength="150"
                               placeholder="Ej. Almacén TI"
                               class="field-control" />

                    </div>


                    @* Fecha compra *@

                    <div>

                        <label class="field-label">
                            Fecha de compra
                        </label>

                        <input type="date"
                               @bind="purchaseDate"
                               class="field-control" />

                    </div>

                </div>


                @* =================================================
                   TIPO DE PROPIEDAD
                   ================================================= *@

                <div class="section-divider"></div>


                <div>

                    <p class="section-label">
                        Propiedad del activo
                    </p>

                    <p class="mt-2 text-sm text-slate-500">
                        Define si el activo pertenece a la organización
                        o se encuentra bajo arrendamiento.
                    </p>

                </div>


                <div class="ownership-grid mt-5">

                    <button type="button"
                            class="@GetOwnershipClass("Propio")"
                            @onclick='() => SelectOwnership("Propio")'>

                        <div class="ownership-radio">
                            @if (ownershipType == "Propio")
                            {
                                <div class="ownership-radio-dot"></div>
                            }
                        </div>

                        <div class="text-left">

                            <p class="text-sm font-medium text-slate-300">
                                Propio
                            </p>

                            <p class="mt-1 text-xs leading-5 text-slate-600">
                                Activo propiedad de la organización.
                            </p>

                        </div>

                    </button>


                    <button type="button"
                            class="@GetOwnershipClass("Arrendado")"
                            @onclick='() => SelectOwnership("Arrendado")'>

                        <div class="ownership-radio">
                            @if (ownershipType == "Arrendado")
                            {
                                <div class="ownership-radio-dot"></div>
                            }
                        </div>

                        <div class="text-left">

                            <p class="text-sm font-medium text-slate-300">
                                Arrendado
                            </p>

                            <p class="mt-1 text-xs leading-5 text-slate-600">
                                Activo proporcionado por un proveedor.
                            </p>

                        </div>

                    </button>

                </div>


                @if (ownershipType == "Arrendado")
                {
                    <div class="rental-section">

                        <div class="form-grid">

                            <div>

                                <label class="field-label">
                                    Proveedor *
                                </label>

                                <select @bind="supplierId"
                                        class="field-control">

                                    <option value="0">
                                        Selecciona un proveedor
                                    </option>

                                    @foreach (var supplier in activeSuppliers)
                                    {
                                        <option value="@supplier.Id">
                                            @supplier.Name
                                        </option>
                                    }

                                </select>


                                @if (activeSuppliers.Count == 0)
                                {
                                    <p class="mt-2 text-xs text-amber-300/70">
                                        No existen proveedores activos disponibles.
                                    </p>
                                }

                            </div>


                            <div>

                                <label class="field-label">
                                    Fin de arrendamiento *
                                </label>

                                <input type="date"
                                       @bind="rentalEndDate"
                                       class="field-control" />

                            </div>

                        </div>


                        @if (SelectedSupplier is not null)
                        {
                            <div class="supplier-preview">

                                <div class="supplier-icon">
                                    @GetSupplierInitial()
                                </div>

                                <div>

                                    <p class="text-sm font-medium text-slate-300">
                                        @SelectedSupplier.Name
                                    </p>

                                    <p class="mt-1 text-xs text-slate-600">

                                        @(string.IsNullOrWhiteSpace(SelectedSupplier.ContactName)
                                            ? "Sin contacto registrado"
                                            : SelectedSupplier.ContactName)

                                        @if (!string.IsNullOrWhiteSpace(SelectedSupplier.Email))
                                        {
                                            <span>
                                                · @SelectedSupplier.Email
                                            </span>
                                        }

                                    </p>

                                </div>

                            </div>
                        }

                    </div>
                }


                @if (!string.IsNullOrWhiteSpace(actionError))
                {
                    <div class="error-card mt-6">
                        @actionError
                    </div>
                }


                <div class="mt-8 flex flex-col-reverse gap-3
                    sm:flex-row sm:justify-end">

                    <button type="button"
                            class="secondary-button"
                            disabled="@isSubmitting"
                            @onclick="GoBack">

                        Cancelar

                    </button>


                    <button type="button"
                            class="primary-button"
                            disabled="@(!CanSubmit)"
                            @onclick="CreateAsset">

                        @if (isSubmitting)
                        {
                            <span class="button-spinner"></span>

                            <span>
                                Registrando...
                            </span>
                        }
                        else
                        {
                            <span>
                                Registrar activo
                            </span>
                        }

                    </button>

                </div>

            </section>


            @* =====================================================
               PANEL DE REGLAS
               ===================================================== *@

            <aside class="rules-column">

                <div class="rules-card">

                    <p class="section-label">
                        Reglas de registro
                    </p>


                    <div class="rule-list mt-5">

                        <div class="rule-item">

                            <span class="rule-check">
                                ✓
                            </span>

                            <p>
                                El código del activo debe ser único.
                            </p>

                        </div>


                        <div class="rule-item">

                            <span class="rule-check">
                                ✓
                            </span>

                            <p>
                                Categoría y marca son datos obligatorios.
                            </p>

                        </div>


                        <div class="rule-item">

                            <span class="rule-check">
                                ✓
                            </span>

                            <p>
                                Los activos nuevos se incorporan al
                                inventario para su posterior gestión.
                            </p>

                        </div>

                    </div>

                </div>


                <div class="@GetContextRuleClass()">

                    <div class="rule-symbol">
                        i
                    </div>

                    <div>

                        <p class="text-sm font-medium text-slate-300">
                            @GetContextRuleTitle()
                        </p>

                        <p class="mt-1 text-xs leading-5 text-slate-600">
                            @GetContextRuleDescription()
                        </p>

                    </div>

                </div>


                <div class="summary-card">

                    <p class="section-label">
                        Resumen
                    </p>


                    <div class="summary-list mt-5">

                        <div>
                            <span>Código</span>
                            <strong>@DisplayValue(assetCode)</strong>
                        </div>

                        <div>
                            <span>Activo</span>
                            <strong>
                                @GetAssetDescription()
                            </strong>
                        </div>

                        <div>
                            <span>Propiedad</span>
                            <strong>@DisplayValue(ownershipType)</strong>
                        </div>

                        @if (ownershipType == "Arrendado")
                        {
                            <div>
                                <span>Proveedor</span>

                                <strong>
                                    @(SelectedSupplier?.Name ?? "Pendiente")
                                </strong>
                            </div>
                        }

                    </div>

                </div>

            </aside>

        </div>
    }

</div>


<style>

    .create-page {
        width: 100%;
        max-width: 1320px;
        margin-inline: auto;
    }


    .back-link {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        color: #64748b;
        font-size: 13px;
        transition: color .16s ease;
    }


        .back-link:hover {
            color: #cbd5e1;
        }


    .form-card,
    .rules-card,
    .summary-card {
        border: 1px solid rgba(255,255,255,.055);
        border-radius: 16px;
        background: linear-gradient( 145deg, rgba(255,255,255,.022), rgba(255,255,255,.007) );
    }


    .form-card {
        padding: 24px;
    }


    .rules-card,
    .summary-card {
        padding: 20px;
    }


    .rules-column {
        display: flex;
        flex-direction: column;
        gap: 16px;
        align-self: start;
    }


    .section-header {
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        gap: 20px;
    }


    .section-label,
    .field-label {
        color: #475569;
        font-size: 10px;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: .12em;
    }


    .required-hint {
        color: #475569;
        font-size: 10px;
    }


    .form-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0,1fr));
        gap: 20px;
    }


    .field-control {
        width: 100%;
        margin-top: 9px;
        padding: 12px 13px;
        border: 1px solid rgba(148,163,184,.12);
        border-radius: 11px;
        outline: none;
        background: #0d1014;
        color: #cbd5e1;
        font-size: 13px;
        transition: border-color .17s ease, background .17s ease;
    }


        .field-control:focus {
            border-color: rgba(148,163,184,.30);
            background: #0f1216;
        }


        .field-control::placeholder {
            color: #334155;
        }


    .section-divider {
        height: 1px;
        margin: 30px 0;
        background: rgba(255,255,255,.045);
    }


    .ownership-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0,1fr));
        gap: 12px;
    }


    .ownership-option {
        display: flex;
        align-items: flex-start;
        gap: 13px;
        min-height: 82px;
        padding: 15px;
        border: 1px solid rgba(148,163,184,.09);
        border-radius: 12px;
        background: rgba(255,255,255,.01);
        transition: border-color .17s ease, background .17s ease;
    }


        .ownership-option:hover {
            border-color: rgba(148,163,184,.18);
            background: rgba(255,255,255,.018);
        }


    .ownership-selected {
        border-color: rgba(203,213,225,.24);
        background: rgba(203,213,225,.035);
    }


    .ownership-radio {
        display: flex;
        width: 16px;
        height: 16px;
        flex-shrink: 0;
        align-items: center;
        justify-content: center;
        margin-top: 2px;
        border: 1px solid rgba(148,163,184,.25);
        border-radius: 9999px;
    }


    .ownership-radio-dot {
        width: 6px;
        height: 6px;
        border-radius: 9999px;
        background: #cbd5e1;
    }


    .rental-section {
        margin-top: 18px;
        padding: 18px;
        border: 1px solid rgba(148,163,184,.07);
        border-radius: 13px;
        background: rgba(0,0,0,.11);
    }


    .supplier-preview {
        display: flex;
        align-items: center;
        gap: 12px;
        margin-top: 15px;
        padding: 12px 14px;
        border: 1px solid rgba(255,255,255,.045);
        border-radius: 11px;
