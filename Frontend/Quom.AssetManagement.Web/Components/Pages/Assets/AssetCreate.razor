    }


    .primary-button,
    .secondary-button {
        display: inline-flex;
        min-height: 42px;
        align-items: center;
        justify-content: center;
        gap: 8px;
        padding: 0 17px;
        border-radius: 10px;
        font-size: 13px;
        font-weight: 600;
        transition: background .17s ease, opacity .17s ease;
    }


    .primary-button {
        border: 1px solid rgba(255,255,255,.14);
        background: #e2e8f0;
        color: #111827;
    }


        .primary-button:hover:not(:disabled) {
            background: #f8fafc;
        }


        .primary-button:disabled {
            cursor: not-allowed;
            opacity: .35;
        }


    .secondary-button {
        border: 1px solid rgba(148,163,184,.10);
        background: rgba(255,255,255,.015);
        color: #64748b;
    }


        .secondary-button:hover:not(:disabled) {
            color: #cbd5e1;
            background: rgba(255,255,255,.035);
        }


    .create-spinner,
    .button-spinner {
        border: 2px solid rgba(148,163,184,.12);
        border-top-color: #94a3b8;
        border-radius: 9999px;
        animation: createSpin .7s linear infinite;
    }


    .create-spinner {
        width: 26px;
        height: 26px;
    }


    .button-spinner {
        width: 14px;
        height: 14px;
        border-color: rgba(15,23,42,.22);
        border-top-color: #0f172a;
    }


    @@keyframes createSpin {

        to {
            transform: rotate(360deg);
        }
    }


    @@media (max-width: 700px) {

        .form-grid,
        .ownership-grid {
            grid-template-columns: 1fr;
        }


        .section-header {
            flex-direction: column;
        }
    }

</style>


@code {

    private string assetCode = string.Empty;
    private string serialNumber = string.Empty;
    private string category = string.Empty;
    private string brand = string.Empty;
    private string model = string.Empty;

    private string ownershipType = "Propio";

    private int supplierId;

    private string currentLocation = string.Empty;

    private DateTime? purchaseDate;
    private DateTime? rentalEndDate;


    private List<SupplierModel> activeSuppliers = [];


    private bool isLoading = true;
    private bool isSubmitting;

    private string? loadError;
    private string? actionError;


    private SupplierModel? SelectedSupplier =>
        activeSuppliers.FirstOrDefault(
            supplier => supplier.Id == supplierId);


    private bool CanSubmit =>
        AuthState.IsAdministrator
        && !isSubmitting
        && !string.IsNullOrWhiteSpace(assetCode)
        && !string.IsNullOrWhiteSpace(category)
        && !string.IsNullOrWhiteSpace(brand)
        && !string.IsNullOrWhiteSpace(ownershipType)
        && (
            ownershipType != "Arrendado"
            ||
            (
                supplierId > 0
                && rentalEndDate.HasValue
            )
        );


    protected override async Task OnInitializedAsync()
    {
        await LoadDataAsync();
    }


    private async Task LoadDataAsync()
    {
        try
        {
            isLoading = true;

            if (!AuthState.IsAdministrator)
                return;

            var suppliers =
                await SupplierApiService.GetAllAsync();

            activeSuppliers =
                suppliers
                    .Where(supplier => supplier.IsActive)
                    .OrderBy(supplier => supplier.Name)
                    .ToList();
        }
        catch (Exception ex)
        {
            loadError = ex.Message;
        }
        finally
        {
            isLoading = false;
        }
    }


    private void SelectOwnership(string type)
    {
        ownershipType = type;

        actionError = null;

        if (type == "Propio")
        {
            supplierId = 0;
            rentalEndDate = null;
        }
    }


    private async Task CreateAsset()
    {
        if (!CanSubmit)
            return;

        try
        {
            isSubmitting = true;
            actionError = null;

            var request =
                new CreateAssetRequest
                {
                    AssetCode =
                        assetCode.Trim(),

                    SerialNumber =
                        Normalize(serialNumber),

                    Category =
                        category.Trim(),

                    Brand =
                        brand.Trim(),

                    Model =
                        Normalize(model),

                    OwnershipType =
                        ownershipType,

                    SupplierId =
                        ownershipType == "Arrendado"
                            ? supplierId
                            : null,

                    CurrentLocation =
                        Normalize(currentLocation),

                    PurchaseDate =
                        purchaseDate,

                    RentalEndDate =
                        ownershipType == "Arrendado"
                            ? rentalEndDate
                            : null
                };


            var id =
                await AssetApiService.CreateAsync(request);


            Navigation.NavigateTo(
                $"/assets/{id}/history");
        }
        catch (Exception ex)
        {
            actionError = ex.Message;
        }
        finally
        {
            isSubmitting = false;
        }
    }


    private void GoBack()
    {
        Navigation.NavigateTo("/assets");
    }


    private string GetOwnershipClass(string type)
    {
        return ownershipType == type
            ? "ownership-option ownership-selected"
            : "ownership-option";
    }


    private string GetContextRuleClass()
    {
        return ownershipType == "Arrendado"
            ? "context-rule-rental"
            : "context-rule";
    }


    private string GetContextRuleTitle()
    {
        return ownershipType == "Arrendado"
            ? "Activo arrendado"
            : "Activo propio";
    }


    private string GetContextRuleDescription()
    {
        return ownershipType == "Arrendado"
            ? "El proveedor y la fecha de término del arrendamiento son obligatorios para completar el registro."
            : "Los activos propios no requieren proveedor ni fecha de término de arrendamiento.";
    }


    private string GetSupplierInitial()
    {
        if (SelectedSupplier is null ||
            string.IsNullOrWhiteSpace(SelectedSupplier.Name))
        {
            return "P";
        }

        return SelectedSupplier.Name[..1]
            .ToUpperInvariant();
    }


    private string GetAssetDescription()
    {
        var description =
            $"{brand.Trim()} {model.Trim()}".Trim();

        return string.IsNullOrWhiteSpace(description)
            ? "Pendiente"
            : description;
    }


    private static string DisplayValue(string? value)
    {
        return string.IsNullOrWhiteSpace(value)
            ? "Pendiente"
            : value;
    }


    private static string? Normalize(string? value)
    {
        return string.IsNullOrWhiteSpace(value)
            ? null
            : value.Trim();
    }

}