@inherits LayoutComponentBase

@using Quom.AssetManagement.Web.State
@using Quom.AssetManagement.Web.Services

@inject AuthState AuthState
@inject AuthService AuthService
@inject NavigationManager Navigation

@if (!authChecked)
{
    <div class="auth-loading-screen">

        <div class="auth-loading-content">

            <div class="auth-spinner"></div>

            <p>
                Validando sesión...
            </p>

        </div>

    </div>
}
else if (AuthState.IsAuthenticated)
{
    <div class="app-shell">

        <aside class="app-sidebar">

            <div>

                <div class="flex items-center gap-3">

                    <div class="sidebar-logo">
                        Q
                    </div>

                    <div>

                        <p class="font-semibold text-white">
                            Quom
                        </p>

                        <p class="text-xs text-slate-500">
                            Asset Management
                        </p>

                    </div>

                </div>


                <nav class="mt-10 space-y-2">

                    <NavLink href="/assets"
                             class="nav-item"
                             ActiveClass="nav-item-active">

                        <span>
                            Activos
                        </span>

                    </NavLink>


                    <NavLink href="/employees"
                             class="nav-item"
                             ActiveClass="nav-item-active">

                        <span>
                            Empleados
                        </span>

                    </NavLink>


                    <NavLink href="/suppliers"
                             class="nav-item"
                             ActiveClass="nav-item-active">

                        <span>
                            Proveedores
                        </span>

                    </NavLink>

                </nav>

            </div>


            <div class="sidebar-footer">

                <button class="logout-button"
                        disabled="@isLoggingOut"
                        @onclick="Logout">

                    @if (isLoggingOut)
                    {
                        <span>
                            Cerrando sesión...
                        </span>
                    }
                    else
                    {
                        <span>
                            Cerrar sesión
                        </span>
                    }

                </button>

            </div>

        </aside>


        <div class="app-content">

            <header class="app-header">

                <div>

                    <p class="text-sm text-slate-500">
                        Sistema de gestión de activos
                    </p>

                </div>


                <div class="flex items-center gap-3">

                    <div class="text-right">

                        <p class="text-sm font-medium text-slate-200">
                            @AuthState.Username
                        </p>

                        <p class="text-xs text-slate-500">
                            @AuthState.Role
                        </p>

                    </div>


                    <div class="user-avatar">
                        @UserInitial
                    </div>

                </div>

            </header>


            <main class="app-main">

                @Body

            </main>

        </div>

    </div>
}


<style>

    /* ======================================================
           VALIDACIÓN DE SESIÓN
           ====================================================== */

    .auth-loading-screen {
        display: flex;
        min-height: 100vh;
        align-items: center;
        justify-content: center;
        background: radial-gradient( circle at 85% 10%, rgba(71,85,105,.05), transparent 28% ), #090b0e;
        color: #64748b;
    }


    .auth-loading-content {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 14px;
        font-size: 13px;
    }


    .auth-spinner {
        width: 25px;
        height: 25px;
        border: 2px solid rgba(148,163,184,.12);
        border-top-color: #94a3b8;
        border-radius: 9999px;
        animation: authSpin .7s linear infinite;
    }


    /* ======================================================
           LAYOUT
           ====================================================== */

    .app-shell {
        display: grid;
        min-height: 100vh;
        grid-template-columns: 250px 1fr;
        background: radial-gradient( circle at 85% 10%, rgba(71,85,105,.055), transparent 28% ), #090b0e;
        color: #e2e8f0;
    }


    /* ======================================================
           SIDEBAR
           ====================================================== */

    .app-sidebar {
        position: sticky;
        top: 0;
        display: flex;
        height: 100vh;
        flex-direction: column;
        justify-content: space-between;
        padding: 28px 22px;
        border-right: 1px solid rgba(255,255,255,.06);
        background: rgba(10,12,15,.82);
        backdrop-filter: blur(18px);
    }


    .sidebar-logo {
        display: flex;
        width: 42px;
        height: 42px;
        align-items: center;
        justify-content: center;
        border: 1px solid rgba(255,255,255,.11);
        border-radius: 12px;
        background: linear-gradient( 145deg, rgba(255,255,255,.07), rgba(255,255,255,.015) );
        color: white;
        font-weight: 700;
    }


    /* ======================================================
           NAVEGACIÓN
           ====================================================== */

    .nav-item {
        display: flex;
        align-items: center;
        min-height: 44px;
        padding: 0 14px;
        border: 1px solid transparent;
        border-radius: 11px;
        color: #64748b;
        font-size: 14px;
        text-decoration: none;
        transition: background .18s ease, color .18s ease, border-color .18s ease;
    }


        .nav-item:hover {
            color: #cbd5e1;
            background: rgba(255,255,255,.025);
        }


    .nav-item-active {
        color: #f1f5f9;
        border-color: rgba(255,255,255,.07);
        background: rgba(255,255,255,.045);
    }


    /* ======================================================
           FOOTER SIDEBAR
           ====================================================== */

    .sidebar-footer {
        padding-top: 20px;
        border-top: 1px solid rgba(255,255,255,.05);
    }


    .logout-button {
        width: 100%;
        padding: 11px 14px;
        border: 1px solid rgba(255,255,255,.07);
        border-radius: 10px;
        background: rgba(255,255,255,.02);
        color: #64748b;
        font-size: 13px;
        transition: color .18s ease, background .18s ease, opacity .18s ease;
    }


        .logout-button:hover:not(:disabled) {
            color: #e2e8f0;
            background: rgba(255,255,255,.045);
        }


        .logout-button:disabled {
            cursor: not-allowed;
            opacity: .5;
        }


    /* ======================================================
           CONTENIDO
           ====================================================== */

    .app-content {
        min-width: 0;
    }


    .app-header {
        display: flex;
        height: 76px;
        align-items: center;
        justify-content: space-between;
        padding: 0 36px;
        border-bottom: 1px solid rgba(255,255,255,.055);
        background: rgba(9,11,14,.70);
        backdrop-filter: blur(18px);
    }


    .user-avatar {
        display: flex;
        width: 38px;
        height: 38px;
        align-items: center;
        justify-content: center;
        border: 1px solid rgba(255,255,255,.08);
        border-radius: 10px;
        background: rgba(255,255,255,.035);
        color: #cbd5e1;
        font-size: 13px;
        font-weight: 600;
    }


    .app-main {
        padding: 36px;
    }


    /* ======================================================
           ANIMACIONES
           ====================================================== */

    @@keyframes authSpin {

        to {
            transform: rotate(360deg);
        }
    }


    /* ======================================================
           RESPONSIVE
           ====================================================== */

    @@media (max-width: 900px) {

        .app-shell {
            grid-template-columns: 1fr;
        }


        .app-sidebar {
            display: none;
        }


        .app-main {
            padding: 24px;
        }
    }


    @@media (prefers-reduced-motion: reduce) {

        .auth-spinner {
            animation-duration: 1.4s;
        }
    }

</style>


@code {

    private bool authChecked;

    private bool isLoggingOut;


    private string UserInitial =>
        string.IsNullOrWhiteSpace(
            AuthState.Username)
                ? "U"
                : AuthState.Username[..1]
                    .ToUpperInvariant();


    /*
     * ProtectedSessionStorage necesita que Blazor
     * ya esté conectado al navegador.
     *
     * Por eso la restauración se realiza en
     * OnAfterRenderAsync y no en OnInitialized.
     */
    protected override async Task OnAfterRenderAsync(
        bool firstRender)
    {
        if (!firstRender)
            return;


        if (!AuthState.IsAuthenticated)
        {
            var restored =
                await AuthService
                    .RestoreSessionAsync();


            if (!restored)
            {
                authChecked = true;

                Navigation.NavigateTo(
                    "/",
                    replace: true);

                return;
            }
        }


        authChecked = true;

        StateHasChanged();
    }


    private async Task Logout()
    {
        if (isLoggingOut)
            return;


        try
        {
            isLoggingOut = true;


            await AuthService
                .LogoutAsync();


            Navigation.NavigateTo(
                "/",
                replace: true);
        }
        finally
        {
            isLoggingOut = false;
        }
    }

}